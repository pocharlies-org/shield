# Sauvage deployment template. Copy to a secret-managed environment; never commit real tokens.
INSTANCE_ID=sauvage
DB=/srv/data/sauvage.db
FILES_DYNAMIC=/srv/data
# Keep the upstream preset corpus out of a fresh Sauvage database; Ornith and
# the deterministic topic rules are the moderation sources for this deployment.
FILES_SAMPLES=/srv/empty-samples
CONVERT=disabled

# Operational dashboard. Authentication is asserted by Traefik/Keycloak and
# independently restricted by Shield to this exact Google identity.
SERVER_ENABLED=true
SERVER_LISTEN=:8080
SERVER_PROBE_LISTEN=:9090
SERVER_FORWARD_AUTH_HEADER=X-Auth-Request-Email
SERVER_FORWARD_AUTH_EMAILS=me@e-dani.com
SERVER_FORWARD_AUTH_PROXY_CIDRS=10.42.0.0/16,100.107.21.89/32,100.71.117.127/32,100.75.189.75/32,100.109.183.9/32

TELEGRAM_TOKEN=replace-with-botfather-token
TELEGRAM_GROUPS=-1003672565710
ADMIN_GROUP=replace-with-private-admin-chat-id
SUPER_USER=replace-with-numeric-telegram-admin-ids

# Local OpenAI-compatible LiteLLM/Ornith. Replace the URL if Shield runs outside the cluster.
OPENAI_TOKEN=replace-with-litellm-key
OPENAI_API_BASE=http://litellm.litellm.svc.cluster.local:4000/v1
OPENAI_MODEL=ornith-1.0
OPENAI_RETRY_COUNT=1
OPENAI_CHECK_SHORT_MESSAGES=true
LLM_MODE=always
LLM_HISTORY_CONTEXT_SIZE=8
LLM_REQUEST_TIMEOUT=8s
LLM_MIN_INPUT_CHARS=3

# Check every member message. Disable broad legacy similarity/emoji rules that
# are too noisy for an adult social group; deterministic rules and Ornith stay active.
PARANOID=true
FIRST_MESSAGES_COUNT=0
SIMILARITY_THRESHOLD=0
MAX_EMOJI=-1

# No CAS egress. Slow-path vision remains disabled unless enabled in a rule set.
CAS_API=

# Sauvage forum structure verified from Telegram.
COMMUNITY_ENABLED=true
COMMUNITY_CHAT_ID=-1003672565710
COMMUNITY_PRESENTATION_THREAD_ID=3
COMMUNITY_CONTEST_THREAD_ID=6
COMMUNITY_CONTEST_ID=replace-for-each-contest
COMMUNITY_PRIVATE_CONSENT_TERMS=acepto privados,no acepto privados,privados sí,privados no
COMMUNITY_DAILY_DIGEST=true
COMMUNITY_DAILY_DIGEST_HOUR=9
COMMUNITY_DAILY_DIGEST_TIMEZONE=Europe/Madrid
COMMUNITY_DASHBOARD_URL=https://sauvage-bot.e-dani.com

# Safe rollout default. Change to true only after reviewing shadow decisions.
COMMUNITY_APPLY_ACTIONS=false

# Global shadow switch: Ornith still evaluates and records decisions, but Telegram
# bans, restrictions and deletions are not executed. Change only after review.
DRY=true

# Live conduct escalation after shadow approval: warning, then restrictions.
MODERATION_WARN_STRIKES=1
MODERATION_FIRST_STRIKE=1h
MODERATION_SECOND_STRIKE=24h
MODERATION_WARN_DELETE_DURATION=15m

# Existing /report workflow, with no report-only automatic permanent bans.
REPORT_ENABLED=true
REPORT_THRESHOLD=2
REPORT_AUTO_BAN_THRESHOLD=0
REPORT_RATE_LIMIT=10
REPORT_RATE_PERIOD=1h

# Retain the minimum operational history needed for audit and appeals.
RETENTION_ENABLED=true
RETENTION_INCOMING_EVENTS_TTL=720h
RETENTION_MODERATION_ACTIONS_TTL=2160h
RETENTION_COMMUNITY_EVENTS_TTL=2160h
RETENTION_INCIDENTS_TTL=2160h
RETENTION_APPEALS_TTL=2160h
RETENTION_INTERVAL=24h

# One-shot archive analysis (use in a separate Job, never in the polling Deployment).
# The source URL must come from secret management and should use a read-only account.
# BACKFILL_ONLY=true
# BACKFILL_SOURCE_DB=postgres://read-only-user:secret@archive-db/whatsappmcp
# BACKFILL_ACCOUNT=personal
# BACKFILL_CONVERSATION_ID=tg_-1003672565710
# BACKFILL_LOOKBACK=168h
# BACKFILL_TOPICS=3,6
# BACKFILL_ALBUM_WINDOW=2s
# LLM_HISTORY_CONTEXT_SIZE=0
